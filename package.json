{
  "name": "codenames-client",
  "version": "0.1.0",
  "description": "TypeScript client for codenames.game",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "dev": "tsc --watch",
    "example": "tsc && node dist/example.js",
    "test": "npm run build && node --test --test-concurrency=1 test/**/*.test.js",
    "test:duet": "npm run build && node --test test/duet-live.test.js",
    "test:classic": "npm run build && node --test test/classic-live.test.js"
  },
  "dependencies": {
    "boardgame.io": "^0.50.2",
    "immer": "^11.1.4",
    "lodash.isplainobject": "^4.0.6",
    "nanoid": "^3.3.7",
    "rxjs": "^7.8.2",
    "socket.io-client": "^4.7.5"
  },
  "devDependencies": {
    "@types/lodash.isplainobject": "^4.0.9",
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0"
  }
}
